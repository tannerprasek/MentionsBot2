PORT=8787
# Shared secret the Siri Shortcut sends as "Authorization: Bearer <token>"
API_TOKEN=change-me
# LAN IP of this machine as seen by the Chromecast (auto-detected if empty)
PUBLIC_HOST=
# Torznab endpoint from Prowlarr or Jackett, e.g.
#   Prowlarr: http://localhost:9696/1/api
#   Jackett:  http://localhost:9117/api/v2.0/indexers/all/results/torznab/api
TORZNAB_URL=
TORZNAB_API_KEY=
DOWNLOAD_DIR=./downloads
# Used when the request doesn't name a TV
DEFAULT_TV=Living Room TV
PREFERRED_QUALITY=1080p
ALLOW_4K=false
# Most Chromecasts can't decode HEVC/x265 in the default receiver
AVOID_HEVC=true
MAX_SIZE_GB=15
MIN_SEEDERS=3
IDLE_HOURS=2
